usage() {
    cat <<EOF
vocab add <word> [word2 ...]       auto-translate one or more
vocab add <word> "meaning"         manual add
vocab delete <id|word> [word2 ...] delete one or more
vocab delete all                   clear everything
vocab quiz                         test yourself
vocab list                         show all
vocab about
EOF
}

init_db

case "$1" in
    add)    shift; cmd_add    "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    quiz)   cmd_quiz              ;;
    list)   cmd_list              ;;
    about)  cmd_about             ;;
    *)      usage                 ;;
esac
