#!/bin/bash
#
#  vocab - English/Turkish vocabulary tool
#  ena ~ github.com/whyghost
#  ingilizce çalışmak isteyenler için yapıldı

DB="$HOME/.vocab.sqlite"

# colors
if [ -t 1 ]; then
    GREEN=$(tput setaf 2 2>/dev/null);  RED=$(tput setaf 1 2>/dev/null)
    YELLOW=$(tput setaf 3 2>/dev/null); BOLD=$(tput bold 2>/dev/null)
    RESET=$(tput sgr0 2>/dev/null)
else
    GREEN=; RED=; YELLOW=; BOLD=; RESET=
fi

init_db() {
    sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS vocabulary (
        id         INTEGER PRIMARY KEY AUTOINCREMENT,
        eng_word   TEXT NOT NULL,
        tur_word   TEXT NOT NULL,
        created_at TEXT DEFAULT (datetime('now','localtime'))
    );"
    # add created_at column to old databases (if missing)
    sqlite3 "$DB" "ALTER TABLE vocabulary ADD COLUMN created_at TEXT DEFAULT (datetime('now','localtime'));" 2>/dev/null || true
    sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS stats (
        id      INTEGER PRIMARY KEY AUTOINCREMENT,
        mode    TEXT NOT NULL,
        correct INTEGER NOT NULL,
        total   INTEGER NOT NULL,
        date    TEXT DEFAULT (datetime('now','localtime'))
    );"
}

translate() {
    local word="$1" tgt="$2"
    python3 - "$word" "$tgt" <<'EOF'
import sys, urllib.request, urllib.parse, json

q   = urllib.parse.quote(sys.argv[1])
tgt = sys.argv[2]

try:
    url  = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl={tgt}&dt=t&q={q}"
    raw  = urllib.request.urlopen(url, timeout=8).read()
    data = json.loads(raw.decode("utf-8"))
    out  = data[0][0][0].strip()
    src  = data[2]
except:
    sys.exit(1)

if not out or out.upper() == sys.argv[1].upper():
    sys.exit(1)

print(f"{src}|{out}")
EOF
}

# check if word contains turkish characters
is_turkish() {
    echo "$1" | grep -qP '[çÇğĞıİöÖşŞüÜ]'
}

# find smallest unused id (fills gaps)
_next_id() {
    sqlite3 "$DB" "SELECT MIN(fill) FROM (
        SELECT 1 AS fill WHERE 1 NOT IN (SELECT id FROM vocabulary)
        UNION ALL
        SELECT id + 1 FROM vocabulary WHERE id + 1 NOT IN (SELECT id FROM vocabulary)
    );"
}

# text-to-speech using Google Translate TTS (primary) or espeak (fallback)
_play_audio() {
    local file="$1"
    if command -v ffplay &>/dev/null; then
        ffplay -nodisp -autoexit -loglevel quiet "$file" 2>/dev/null
    elif command -v mpg123 &>/dev/null; then
        mpg123 -q "$file" 2>/dev/null
    elif command -v mpv &>/dev/null; then
        mpv --no-video --quiet "$file" 2>/dev/null
    elif command -v paplay &>/dev/null; then
        paplay "$file" 2>/dev/null
    elif command -v aplay &>/dev/null; then
        aplay "$file" 2>/dev/null
    else
        return 1
    fi
}

speak() {
    local word="$1" lang="$2"
    word="${word//\'/\\\'}"

    if command -v curl &>/dev/null; then
        local tmpfile
        tmpfile=$(mktemp /tmp/vocab-tts-XXXXXX 2>/dev/null) || tmpfile="/tmp/vocab-tts-$$"
        python3 -c "
import sys, urllib.request, urllib.parse
try:
    url = 'https://translate.google.com/translate_tts?ie=UTF-8&tl=' + sys.argv[2] + '&q=' + urllib.parse.quote(sys.argv[1]) + '&client=tw-ob'
    data = urllib.request.urlopen(url, timeout=8).read()
    with open(sys.argv[3], 'wb') as f:
        f.write(data)
except:
    sys.exit(1)
" "$word" "$lang" "$tmpfile" && _play_audio "$tmpfile"
        local ret=$?
        rm -f "$tmpfile"
        [ $ret -eq 0 ] && return 0
    fi

    if command -v espeak-ng &>/dev/null; then
        espeak-ng -v "$lang" "$word" 2>/dev/null
    elif command -v espeak &>/dev/null; then
        espeak -v "$lang" "$word" 2>/dev/null
    else
        return 1
    fi
}

# add single word, called by cmd_add
_add_one() {
    local word="$1" meaning="$2"
    local new_id
    new_id=$(_next_id)
    word="${word//\'/\'\'}"

    if [ -n "$meaning" ]; then
        meaning="${meaning//\'/\'\'}"
        sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$word', '$meaning');"
        echo "$word -> $meaning"
        return
    fi

    echo "looking up '$word'..."

    local output primary src translation alts turkish_word=false
    local tgt1="tr" tgt2="en"
    is_turkish "$word" && tgt1="en" tgt2="tr"

    output=$(python3 - "$word" "$tgt1" "$tgt2" <<'PYEOF' 2>/dev/null
import sys, urllib.request, urllib.parse, json
word = sys.argv[1]
tgt1, tgt2 = sys.argv[2], sys.argv[3]
q = urllib.parse.quote(word)
for tgt in (tgt1, tgt2):
    try:
        url  = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl={tgt}&dt=t&dt=bd&q={q}"
        raw  = urllib.request.urlopen(url, timeout=8).read()
        data = json.loads(raw.decode("utf-8"))
        out  = data[0][0][0].strip()
        src  = data[2]
    except:
        continue
    if out and out.upper() != word.upper():
        print(f"{src}|{out}")
        if len(data) > 1 and data[1]:
            seen = set()
            for entry in data[1]:
                for alt in entry[1]:
                    a = alt.strip()
                    if a and a != out and a not in seen:
                        seen.add(a)
                        print(f"ALT|{a}")
        sys.exit(0)
sys.exit(1)
PYEOF
)
    [ -z "$output" ] && { echo "  couldn't fetch '$word'" >&2; return 1; }

    primary=$(echo "$output" | head -1)
    alts=$(echo "$output" | tail -n +2 | sed -n 's/^ALT|//p')
    src="${primary%%|*}"
    translation="${primary#*|}"
    translation="${translation//\'/\'\'}"
    is_turkish "$word" && turkish_word=true

    if [ -n "$alts" ]; then
        local items=("$translation")
        while IFS= read -r alt; do
            [ -n "$alt" ] && items+=("$alt")
        done <<< "$alts"

        echo "  multiple meanings found:"
        for i in "${!items[@]}"; do
            echo "    $((i+1))) ${items[$i]}"
        done
        echo "    a) add all"
        read -rp "  choose (e.g. 1,3,5 or Enter for primary): " choice

        local selected_indices=()
        if [ -z "$choice" ]; then
            selected_indices=(0)
        elif [ "$choice" = "a" ]; then
            for i in "${!items[@]}"; do selected_indices+=("$i"); done
        else
            local nums
            nums=$(echo "$choice" | tr ',' ' ' | tr -s ' ')
            for n in $nums; do
                local idx=$((n - 1))
                [ "$idx" -ge 0 ] 2>/dev/null && [ "$idx" -lt "${#items[@]}" ] 2>/dev/null && selected_indices+=("$idx")
            done
            [ ${#selected_indices[@]} -eq 0 ] && selected_indices=(0)
        fi

        for idx in "${selected_indices[@]}"; do
            local item="${items[$idx]}"
            item="${item//\'/\'\'}"
            new_id=$(_next_id)
            if $turkish_word; then
                sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$item', '$word');"
                echo "  $item -> $word"
            else
                sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$word', '$item');"
                echo "  $word -> $item"
            fi
        done
    else
        if $turkish_word; then
            sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$translation', '$word');"
            echo "$translation -> $word"
        else
            sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$word', '$translation');"
            echo "$word -> $translation"
        fi
    fi
}

cmd_add() {
    [ -z "$1" ] && { echo "usage: vocab add <word> [word2 word3 ...]" >&2; exit 1; }

    # two args and second is quoted -> manual add
    if [ $# -eq 2 ] && [[ "$2" != -* ]]; then
        _add_one "$1" "$2"
        return
    fi

    for word in "$@"; do
        _add_one "$word"
    done
}

cmd_translate() {
    [ -z "$1" ] && { echo "usage: vocab translate <word>" >&2; exit 1; }
    local word="$1" output
    local tgt1="tr" tgt2="en"
    is_turkish "$word" && tgt1="en" tgt2="tr"

    output=$(python3 - "$word" "$tgt1" "$tgt2" <<'PYEOF' 2>/dev/null
import sys, urllib.request, urllib.parse, json
word = sys.argv[1]
tgt1, tgt2 = sys.argv[2], sys.argv[3]
q = urllib.parse.quote(word)
for tgt in (tgt1, tgt2):
    try:
        url  = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl={tgt}&dt=t&dt=bd&q={q}"
        raw  = urllib.request.urlopen(url, timeout=8).read()
        data = json.loads(raw.decode("utf-8"))
        out  = data[0][0][0].strip()
        src  = data[2]
    except:
        continue
    if out and out.upper() != word.upper():
        print(f"{src}|{out}")
        if len(data) > 1 and data[1]:
            seen = set()
            for entry in data[1]:
                for alt in entry[1]:
                    a = alt.strip()
                    if a and a != out and a not in seen:
                        seen.add(a)
                        print(f"ALT|{a}")
        sys.exit(0)
sys.exit(1)
PYEOF
)
    [ -z "$output" ] && { echo "  couldn't fetch '$word'" >&2; exit 1; }

    local primary alts
    primary=$(echo "$output" | head -1)
    alts=$(echo "$output" | tail -n +2 | sed -n 's/^ALT|//p')

    echo "${primary#*|}"
    if [ -n "$alts" ]; then
        echo "alternatives:"
        while IFS= read -r alt; do
            [ -n "$alt" ] && echo "  - $alt"
        done <<< "$alts"
    fi
}

cmd_speak() {
    [ -z "$1" ] && { echo "usage: vocab speak <word>" >&2; exit 1; }
    local word="$1"
    local lang="en"; is_turkish "$word" && lang="tr"
    speak "$word" "$lang" && return
    echo "  install espeak-ng for voice support" >&2
}

cmd_search() {
    [ -z "$1" ] && { echo "usage: vocab search <word>" >&2; exit 1; }
    local term="$1"
    term="${term//\'/\'\'}"
    local sqlesc
    sqlesc="${term//%/\\%}"; sqlesc="${sqlesc//_/\\_}"
    local rows
    rows=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word, created_at FROM vocabulary
           WHERE eng_word LIKE '%$sqlesc%' ESCAPE '\' OR tur_word LIKE '%$sqlesc%' ESCAPE '\'
           ORDER BY eng_word, tur_word;")
    if [ -z "$rows" ]; then
        echo "  not found: '$1'" >&2
        local prefix
        prefix=$(echo "$1" | head -c 1)
        [ -z "$prefix" ] && return 1
        local psql
        psql="${prefix//%/\\%}"; psql="${psql//_/\\_}"
        local suggest
        suggest=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary
                 WHERE eng_word LIKE '$psql%' ESCAPE '\' OR tur_word LIKE '$psql%' ESCAPE '\'
                 ORDER BY eng_word, tur_word LIMIT 5;")
        [ -n "$suggest" ] && echo "  did you mean?" && \
        while IFS='|' read -r id e t; do
            printf "    %-15s -> %s\n" "$e" "$t"
        done <<< "$suggest"
        return 1
    fi
    printf "%-4s %-15s %-15s %s\n" "id" "en" "tr" "date"
    while IFS='|' read -r id eng tur date; do
        printf "%-4s %-15s %-15s %s\n" "$id" "$eng" "$tur" "$date"
    done <<< "$rows"
}

# delete single word by id or text
_del_one() {
    local target="$1"
    target="${target//\'/\'\'}"

    local rows
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        rows=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary WHERE id = $target;")
    else
        local sqlesc
        sqlesc="${target//%/\\%}"; sqlesc="${sqlesc//_/\\_}"
        rows=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary
               WHERE eng_word LIKE '$sqlesc' ESCAPE '\' OR tur_word LIKE '$sqlesc' ESCAPE '\';")
    fi

    [ -z "$rows" ] && { echo "  not found: '$target'" >&2; return 1; }

    if [ "$(echo "$rows" | wc -l)" -gt 1 ]; then
        echo "multiple matches for '$target':"
        local i=1 ids=() engs=() turs=()
        while IFS='|' read -r id eng tur; do
            echo "  $i) $eng -> $tur  [id:$id]"
            ids[$i]="$id"; engs[$i]="$eng"; turs[$i]="$tur"
            (( i++ ))
        done <<< "$rows"
        local total=$((i - 1))
        echo "  a) delete all"
        echo "  0) skip"
        read -rp "> " choice
        if [ -z "$choice" ] || [ "$choice" = "0" ]; then
            echo "  skipped."; return
        fi
        local indices=()
        if [ "$choice" = "a" ]; then
            for j in $(seq 1 $total); do indices+=("$j"); done
        else
            local nums
            nums=$(echo "$choice" | tr ',' ' ' | tr -s ' ')
            for n in $nums; do
                if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$total" ]; then
                    indices+=("$n")
                fi
            done
            [ ${#indices[@]} -eq 0 ] && { echo "  skipped."; return; }
        fi
        for idx in "${indices[@]}"; do
            sqlite3 "$DB" "DELETE FROM vocabulary WHERE id = ${ids[$idx]};"
            echo "  deleted: ${engs[$idx]} -> ${turs[$idx]}"
        done
    else
        local row="$rows" id eng tur
        id="${row%%|*}"; row="${row#*|}"
        eng="${row%%|*}"; tur="${row##*|}"
        sqlite3 "$DB" "DELETE FROM vocabulary WHERE id = $id;"
        echo "deleted: $eng -> $tur"
    fi
}

cmd_delete() {
    [ -z "$1" ] && { echo "usage: vocab delete <id|word|all> [word2 ...]" >&2; exit 1; }

    if [ "$1" = "all" ]; then
        read -rp "delete everything? [y/N] " c
        [[ "$c" =~ ^[yY]$ ]] && sqlite3 "$DB" "DELETE FROM vocabulary;" && echo "done." || echo "cancelled."
        return
    fi

    # multiple targets -> no confirm, single -> ask
    if [ $# -gt 1 ]; then
        read -rp "delete $# entries? [y/N] " c
        [[ "$c" =~ ^[yY]$ ]] || { echo "cancelled."; return; }
        for target in "$@"; do
            _del_one "$target"
        done
    else
        local orig="$1" rows
        local target="${orig//\'/\'\'}"
        if [[ "$target" =~ ^[0-9]+$ ]]; then
            rows=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary WHERE id = $target;")
        else
            local sqlesc
            sqlesc="${target//%/\\%}"; sqlesc="${sqlesc//_/\\_}"
            rows=$(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary
                   WHERE eng_word LIKE '$sqlesc' ESCAPE '\' OR tur_word LIKE '$sqlesc' ESCAPE '\';")
        fi
        [ -z "$rows" ] && { echo "not found: '$orig'" >&2; exit 1; }

        if [ "$(echo "$rows" | wc -l)" -gt 1 ]; then
            echo "multiple matches:"
            local i=1 ids2=() engs2=() turs2=()
            while IFS='|' read -r id eng tur; do
                echo "  $i) $eng -> $tur  [id:$id]"
                ids2[$i]="$id"; engs2[$i]="$eng"; turs2[$i]="$tur"
                (( i++ ))
            done <<< "$rows"
            local total=$((i - 1))
            echo "  a) delete all"
            echo "  0) cancel"
            read -rp "> " choice
            if [ -z "$choice" ] || [ "$choice" = "0" ]; then
                echo "cancelled."; return
            fi
            local indices=()
            if [ "$choice" = "a" ]; then
                for j in $(seq 1 $total); do indices+=("$j"); done
            else
                local nums
                nums=$(echo "$choice" | tr ',' ' ' | tr -s ' ')
                for n in $nums; do
                    if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$total" ]; then
                        indices+=("$n")
                    fi
                done
                [ ${#indices[@]} -eq 0 ] && { echo "cancelled."; return; }
            fi
            for idx in "${indices[@]}"; do
                sqlite3 "$DB" "DELETE FROM vocabulary WHERE id = ${ids2[$idx]};"
                echo "  deleted: ${engs2[$idx]} -> ${turs2[$idx]}"
            done
        else
            local row="$rows" id eng tur
            id="${row%%|*}"; row="${row#*|}"
            eng="${row%%|*}"; tur="${row##*|}"
            read -rp "delete '$eng -> $tur'? [y/N] " c
            [[ "$c" =~ ^[yY]$ ]] && sqlite3 "$DB" "DELETE FROM vocabulary WHERE id = $id;" && echo "deleted." || echo "cancelled."
        fi
    fi
}

cmd_export() {
    sqlite3 "$DB" "SELECT json_group_array(json_object('id',id,'en',eng_word,'tr',tur_word,'date',created_at))
                   FROM vocabulary;" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin), ensure_ascii=False, indent=2))"
}

cmd_import() {
    local file="$1"
    [ -z "$file" ] && { echo "usage: vocab import <file.json>" >&2; exit 1; }
    [ ! -f "$file" ] && { echo "  file not found: $file" >&2; exit 1; }
    local before after
    before=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary;")

    while IFS='|' read -r en tr; do
        [ -z "$en" ] && continue
        local new_id
        new_id=$(_next_id)
        sqlite3 "$DB" "INSERT INTO vocabulary (id, eng_word, tur_word) VALUES ($new_id, '$en', '$tr');"
    done < <(python3 -c "
import sys, json
with open(sys.argv[1]) as f:
    data = json.load(f)
for entry in data:
    en = entry.get('en', entry.get('eng_word', entry.get('eng', ''))).replace(\"'\", \"''\")
    tr = entry.get('tr', entry.get('tur_word', entry.get('tur', ''))).replace(\"'\", \"''\")
    print(en + '|' + tr)
" "$file")

    after=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary;")
    echo "  imported: $((after - before)) new words"
}

cmd_stats() {
    if [ "$1" = "reset" ]; then
        read -rp "delete all quiz/learn stats? vocabulary will NOT be affected. [y/N] " c
        [[ "$c" =~ ^[yY]$ ]] && sqlite3 "$DB" "DELETE FROM stats;" && echo "stats reset done." || echo "cancelled."
        return
    fi
    local total eng_cnt tur_cnt today week latest qc qt qp lc lt lp
    total=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary;")
    eng_cnt=$(sqlite3 "$DB" "SELECT COUNT(DISTINCT eng_word) FROM vocabulary;")
    tur_cnt=$(sqlite3 "$DB" "SELECT COUNT(DISTINCT tur_word) FROM vocabulary;")
    today=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary WHERE created_at >= date('now');")
    week=$(sqlite3 "$DB"  "SELECT COUNT(*) FROM vocabulary WHERE created_at >= date('now','-7 days');")
    latest=$(sqlite3 "$DB" "SELECT created_at FROM vocabulary ORDER BY created_at DESC LIMIT 1;")
    echo "total words:      $total"
    echo "unique english:   $eng_cnt"
    echo "unique turkish:   $tur_cnt"
    echo "added today:      $today"
    echo "added last 7 days: $week"
    [ -n "$latest" ] && echo "last added:       $latest"

    qc=$(sqlite3 "$DB" "SELECT COALESCE(SUM(correct),0) FROM stats WHERE mode='quiz';")
    qt=$(sqlite3 "$DB" "SELECT COALESCE(SUM(total),0) FROM stats WHERE mode='quiz';")
    echo "quiz:             $qc/$qt correct ($([ "$qt" -gt 0 ] && echo "$(( qc * 100 / qt ))%" || echo "-"))"

    lc=$(sqlite3 "$DB" "SELECT COALESCE(SUM(correct),0) FROM stats WHERE mode='learn';")
    lt=$(sqlite3 "$DB" "SELECT COALESCE(SUM(total),0) FROM stats WHERE mode='learn';")
    echo "learn:            $lc/$lt correct ($([ "$lt" -gt 0 ] && echo "$(( lc * 100 / lt ))%" || echo "-"))"
}

# check if two strings are close enough (typo, different form)
_close_enough() {
    local a="$1" b="$2"
    a="${a,,}"; b="${b,,}"
    [ -z "$a" ] || [ -z "$b" ] && return 1
    [ "$a" = "$b" ] && return 0
    [[ "$a" == *"$b"* || "$b" == *"$a"* ]] && return 0
    local dist
    dist=$(awk -v a="$a" -v b="$b" 'BEGIN{
        la=length(a); lb=length(b)
        for(i=0;i<=lb;i++) d[i]=i
        for(i=1;i<=la;i++){
            prev=d[0]; d[0]=i
            for(j=1;j<=lb;j++){
                temp=d[j]
                if(substr(a,i,1)==substr(b,j,1)) d[j]=prev
                else{
                    d[j]=prev+1
                    if(temp+1<d[j]) d[j]=temp+1
                    if(d[j-1]+1<d[j]) d[j]=d[j-1]+1
                }
                prev=temp
            }
        }
        print d[lb]
    }')
    local len=${#a}; [ ${#b} -gt $len ] && len=${#b}
    [ "$dist" -le 2 ] && return 0
    [ "$dist" -le 4 -a "$len" -ge 7 ] && return 0
    [ "$len" -ge 5 -a "$(( dist * 10 / len ))" -le 5 ] && return 0
    return 1
}

cmd_quiz() {
    local count limit="" reverse=0
    count=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary;")
    [ "$count" -eq 0 ] && { echo "no words yet." >&2; exit 1; }

    while [ $# -gt 0 ]; do
        case "$1" in
            --count) shift; limit="$1"; shift ;;
            --reverse) reverse=1; shift ;;
            *) break ;;
        esac
    done

    local i=0 correct=0 total="${limit:-999999}" retry_row="" retry_dir=""
    while [ "$i" -lt "$total" ]; do
        local row eng tur
        if [ -n "$retry_row" ]; then
            row="$retry_row"; retry_row=""
        else
            row=$(sqlite3 "$DB" "SELECT eng_word, tur_word FROM vocabulary ORDER BY RANDOM() LIMIT 1;")
        fi
        [ -z "$row" ] && break
        eng="${row%%|*}"; tur="${row##*|}"
        eng="${eng//\'/\'\'}"; tur="${tur//\'/\'\'}"

        local direction
        if [ -n "$retry_dir" ]; then
            direction="$retry_dir"; retry_dir=""
        else
            direction=$(( RANDOM % 2 ))
        fi
        [ "$reverse" -eq 1 ] && direction=1

        if [ "$direction" -eq 0 ]; then
            local ans all
            ans=$(sqlite3 "$DB" "SELECT tur_word FROM vocabulary WHERE eng_word='$eng' ORDER BY tur_word;")
            all=$(echo "$ans" | paste -sd '/' -)
            read -rp "${YELLOW}$eng${RESET} ? " reply
            local found=0 close=0 a
            while IFS= read -r a; do
                [ "$reply" = "$a" ] && { found=1; break; }
                _close_enough "$reply" "$a" && close=1
            done <<< "$ans"
            if [ "$found" != 1 ]; then
                local rl="${reply,,}" eg="${eng,,}"
                [ "$rl" != "$eg" ] && _close_enough "$reply" "$eng" && close=1
            fi
            if [ "$found" = 1 ]; then
                echo "${GREEN}✓   $eng -> $all${RESET}"
                (( correct++ ))
                (( i++ ))
            elif [ "$close" = 1 ]; then
                echo "${YELLOW}🟡   $eng -> $all${RESET}"
                retry_row="$row"; retry_dir="$direction"
            else
                echo "${RED}✗   $eng -> $all${RESET}"
                (( i++ ))
            fi
        else
            local ans all
            ans=$(sqlite3 "$DB" "SELECT eng_word FROM vocabulary WHERE tur_word='$tur' ORDER BY eng_word;")
            all=$(echo "$ans" | paste -sd '/' -)
            read -rp "${YELLOW}$tur${RESET} ? " reply
            local found=0 close=0 a
            while IFS= read -r a; do
                [ "$reply" = "$a" ] && { found=1; break; }
                _close_enough "$reply" "$a" && close=1
            done <<< "$ans"
            if [ "$found" != 1 ]; then
                local rl="${reply,,}" tg="${tur,,}"
                [ "$rl" != "$tg" ] && _close_enough "$reply" "$tur" && close=1
            fi
            if [ "$found" = 1 ]; then
                echo "${GREEN}✓   $tur -> $all${RESET}"
                (( correct++ ))
                (( i++ ))
            elif [ "$close" = 1 ]; then
                echo "${YELLOW}🟡   $tur -> $all${RESET}"
                retry_row="$row"; retry_dir="$direction"
            else
                echo "${RED}✗   $tur -> $all${RESET}"
                (( i++ ))
            fi
        fi
    done
    [ "$i" -gt 0 ] && sqlite3 "$DB" "INSERT INTO stats (mode, correct, total) VALUES ('quiz', $correct, $i);"
}

cmd_learn() {
    local ids=() engs=() turs=()
    while IFS='|' read -r id eng tur; do
        ids+=("$id"); engs+=("$eng"); turs+=("$tur")
    done < <(sqlite3 "$DB" "SELECT id, eng_word, tur_word FROM vocabulary ORDER BY RANDOM();")
    [ ${#ids[@]} -eq 0 ] && { echo "no words yet." >&2; exit 1; }

    local n=${#ids[@]} wrong_idx=() correct=0 p1=0
    for pass in 1 2; do
        [ "$pass" -eq 2 ] && [ ${#wrong_idx[@]} -eq 0 ] && break
        [ "$pass" -eq 2 ] && echo "${YELLOW}--- pass 2 (${#wrong_idx[@]} to retry) ---${RESET}"

        local new_wrong=() idx=0
        for i in "${!ids[@]}"; do
            [ "$pass" -eq 2 ] && ! echo " ${wrong_idx[*]} " | grep -q " $i " && continue
            local eng="${engs[$i]}" tur="${turs[$i]}"
            eng="${eng//\'/\'\'}"; tur="${tur//\'/\'\'}"
            (( idx++ ))
            local total="$n"; [ "$pass" -eq 2 ] && total="${#wrong_idx[@]}"

            if (( RANDOM % 2 == 0 )); then
                printf "[%d/%d] ${YELLOW}%s${RESET} ? " "$idx" "$total" "$eng"
                read -r reply
                local ans all
                ans=$(sqlite3 "$DB" "SELECT tur_word FROM vocabulary WHERE eng_word='$eng' ORDER BY tur_word;")
                all=$(echo "$ans" | paste -sd '/' -)
                local found=0 close=0 a
                while IFS= read -r a; do
                    [ "$reply" = "$a" ] && { found=1; break; }
                    _close_enough "$reply" "$a" && close=1
                done <<< "$ans"
                if [ "$found" != 1 ]; then
                    local rl="${reply,,}" eg="${eng,,}"
                    [ "$rl" != "$eg" ] && _close_enough "$reply" "$eng" && close=1
                fi
                if [ "$found" = 1 ]; then
                    echo "  ${GREEN}✓   $eng -> $all${RESET}"; (( correct++ ))
                    [ "$pass" -eq 1 ] && (( p1++ ))
                elif [ "$close" = 1 ]; then
                    echo "  ${YELLOW}🟡   $eng -> $all${RESET}"
                    new_wrong+=("$i")
                else
                    echo "  ${RED}✗   $eng -> $all${RESET}"
                    new_wrong+=("$i")
                fi
            else
                printf "[%d/%d] ${YELLOW}%s${RESET} ? " "$idx" "$total" "$tur"
                read -r reply
                local ans all
                ans=$(sqlite3 "$DB" "SELECT eng_word FROM vocabulary WHERE tur_word='$tur' ORDER BY eng_word;")
                all=$(echo "$ans" | paste -sd '/' -)
                local found=0 close=0 a
                while IFS= read -r a; do
                    [ "$reply" = "$a" ] && { found=1; break; }
                    _close_enough "$reply" "$a" && close=1
                done <<< "$ans"
                if [ "$found" != 1 ]; then
                    local rl="${reply,,}" tg="${tur,,}"
                    [ "$rl" != "$tg" ] && _close_enough "$reply" "$tur" && close=1
                fi
                if [ "$found" = 1 ]; then
                    echo "  ${GREEN}✓   $tur -> $all${RESET}"; (( correct++ ))
                    [ "$pass" -eq 1 ] && (( p1++ ))
                elif [ "$close" = 1 ]; then
                    echo "  ${YELLOW}🟡   $tur -> $all${RESET}"
                    new_wrong+=("$i")
                else
                    echo "  ${RED}✗   $tur -> $all${RESET}"
                    new_wrong+=("$i")
                fi
            fi
        done
        wrong_idx=("${new_wrong[@]}")
    done
    local p2=$((correct - p1))
    echo "${BOLD}result: $correct/$n correct (pass1: $p1, pass2: $p2)${RESET}"
    sqlite3 "$DB" "INSERT INTO stats (mode, correct, total) VALUES ('learn', $correct, $n);"
}

cmd_list() {
    local count
    count=$(sqlite3 "$DB" "SELECT COUNT(*) FROM vocabulary;")
    [ "$count" -eq 0 ] && { echo "no words yet." >&2; exit 1; }

    sqlite3 -column -header "$DB" \
        "SELECT id, eng_word AS 'en', tur_word AS 'tr', created_at AS 'date' FROM vocabulary;"
    echo "${BOLD}($count words)${RESET}"
}

