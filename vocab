usage() {
    cat <<EOF
vocab add <word> [word2 ...]          auto-translate one or more
vocab add <word> "meaning"            manual add
vocab translate <word>                quick translation (no save)
vocab speak <word>                    text-to-speech pronunciation
vocab search <word>                   search all meanings
vocab delete <id|word> [word2 ...]    delete one or more
vocab delete all                      clear everything
vocab stats [reset]                   show stats (reset to clear all)
vocab quiz [--count N] [--reverse]    test yourself
vocab learn                           learn mode (retry wrong)
vocab list                            show all
vocab export                          export as JSON
vocab import <file.json>              import from JSON
vocab about
EOF
}

init_db

case "$1" in
    add)       shift; cmd_add       "$@" ;;
    translate) shift; cmd_translate  "$@" ;;
    speak)     shift; cmd_speak      "$@" ;;
    search)    shift; cmd_search     "$@" ;;
    delete)    shift; cmd_delete     "$@" ;;
    stats)     shift; cmd_stats      "$@" ;;
    quiz)      shift; cmd_quiz       "$@" ;;
    learn)     cmd_learn                 ;;
    list)      cmd_list                  ;;
    export)    cmd_export                ;;
    import)    shift; cmd_import     "$@" ;;
    about)     cmd_about                 ;;
    *)         usage                     ;;
esac
